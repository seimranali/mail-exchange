[Unit]
Description=MX background workers (health sampling, mailbox reconciliation, retention, backups)
After=network-online.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=mx
Group=mx
WorkingDirectory=/opt/mx/current/workers
EnvironmentFile=/etc/mx/common.env
EnvironmentFile=/etc/mx/workers.env
ExecStart=/opt/mx/current/workers/MX.Workers
Restart=always
RestartSec=10

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mx
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
UMask=0027

[Install]
WantedBy=multi-user.target
