{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "FormatterName": "json"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Mx": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Issuer": "mx",
    "Audience": "mx-admin",
    "SigningKey": "",
    "AccessTokenMinutes": 60
  },
  "Mail": {
    "DkimSelector": "mx"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Secrets": {
    "KeyEncryptionKey": ""
  }
}
