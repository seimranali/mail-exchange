{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Mx": ""
  },
  "MailServer": {
    "Hostname": "mail.example.com",
    "SmtpPort": 25,
    "ListenAddress": "0.0.0.0",
    "CertificatePath": "/var/lib/mx/tls/mail.pfx",
    "MaxMessageSizeBytes": 36700160,
    "AcceptUnverifiedDomains": false,
    "EnforceDmarcReject": true,
    "SubmissionPort": 587,
    "SubmissionTlsPort": 465,
    "AllowPlaintextAuth": false,
    "MaxSubmissionsPerHour": 200,
    "MaxAuthFailuresPerIp": 5,
    "MaxAuthFailuresPerAccount": 10,
    "AuthFailureWindowMinutes": 15,
    "ImapPort": 143,
    "ImapTlsPort": 993,
    "ImapIdlePollSeconds": 2,
    "ImapAutoLogoutMinutes": 30
  },
  "MailStore": {
    "Root": "/var/lib/mx/mailstore"
  },
  "Filtering": {
    "Enabled": true,
    "JunkThreshold": 5,
    "QuarantineThreshold": 10,
    "RejectThreshold": 20,
    "DnsblZones": [ "zen.spamhaus.org", "bl.spamcop.net" ],
    "QuarantineDays": 30
  },
  "Acme": {
    "Enabled": false,
    "DirectoryUrl": "https://acme-staging-v02.api.letsencrypt.org/directory",
    "Email": "",
    "AcceptTermsOfService": false,
    "Domains": [ "mail.example.com" ],
    "HttpPort": 80,
    "AccountKeyPath": "/var/lib/mx/acme-account.key",
    "RenewBeforeDays": 30
  },
  "Outbound": {
    "RemotePort": 25,
    "OpportunisticTls": true,
    "RequireTls": false,
    "MaxQueueLifetimeHours": 120,
    "MaxConcurrentDeliveries": 10
  },
  "Secrets": {
    "KeyEncryptionKey": ""
  }
}
